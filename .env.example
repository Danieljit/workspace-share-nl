# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/workspace_share?schema=public"

# ---------------------------------------------------------------------------
# Auth.js / NextAuth v5
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`
# AUTH_URL: the canonical app URL (e.g. https://yourdomain.com). Optional in dev.
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-a-strong-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — credentials login works without these).
# Either AUTH_GOOGLE_* (v5) or GOOGLE_CLIENT_* (legacy) is accepted.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Stripe (use TEST keys in development)
# STRIPE_WEBHOOK_SECRET: from `stripe listen` or the dashboard webhook config.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---------------------------------------------------------------------------
# Transactional email (Resend) — optional.
# If unset, emails are logged to the server console instead of sent.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="WorkspaceShare <onboarding@resend.dev>"
# Recipient for contact-form submissions. Falls back to EMAIL_FROM if unset.
CONTACT_EMAIL="hello@workspaceshare.example"

# ---------------------------------------------------------------------------
# Cloudinary (image uploads)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="workspace_share"
